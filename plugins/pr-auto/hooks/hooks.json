{
  "description": "PR の自動作成の決まりをセッション開始時に渡す",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat",
            "args": ["${CLAUDE_PLUGIN_ROOT}/context/pr-auto.md"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
