#!/usr/bin/env python3

import argparse
import json
import math
from pathlib import Path
import subprocess
import tempfile
import time


QUERY = Path(__file__).resolve().parents[1] / "review-threads.graphql"


class PollError(Exception):
    pass


def gh_json(*args):
    command = f"gh {args[0]} {args[1]}"
    try:
        result = subprocess.run(["gh", *args], capture_output=True, check=False)
    except OSError as exc:
        raise PollError(f"{command} を起動できません ({exc.strerror})") from exc
    if result.returncode != 0:
        stderr_lines = result.stderr.decode("utf-8", "replace").splitlines()
        stderr_text = " / ".join(line.strip() for line in stderr_lines if line.strip())
        detail = f": {stderr_text}" if stderr_text else ""
        raise PollError(f"{command} が終了コード {result.returncode} を返しました{detail}")

    try:
        payload = json.loads(result.stdout)
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise PollError(f"{command} の応答を JSON として読めません") from exc
    if not isinstance(payload, dict):
        raise PollError(f"{command} の応答が JSON オブジェクトではありません")
    return payload


def review_threads(owner, repo, number):
    args = [
        "api", "graphql", "-F", f"query=@{QUERY}",
        "-f", f"owner={owner}", "-f", f"repo={repo}", "-F", f"number={number}",
    ]
    threads = []
    cursor_args = []
    seen_cursors = set()
    while True:
        payload = gh_json(*args, *cursor_args)
        if payload.get("errors"):
            raise PollError("gh api graphql の応答にエラーが含まれています")
        page = payload["data"]["repository"]["pullRequest"]["reviewThreads"]
        for thread in page["nodes"]:
            if thread["isResolved"] is False:
                comments = thread["comments"]["nodes"]
                last_comment = (comments[-1]["createdAt"] or "") if comments else ""
                threads.append([thread["id"], last_comment])

        page_info = page["pageInfo"]
        if page_info["hasNextPage"] is False:
            return sorted(threads)
        cursor = page_info["endCursor"]
        if page_info["hasNextPage"] is not True or not cursor or cursor in seen_cursors:
            raise PollError("gh api graphql が次ページの有効なカーソルを返しませんでした")
        seen_cursors.add(cursor)
        cursor_args = ["-f", f"cursor={cursor}"]


def check_status(check):
    if "context" in check:
        return [check["context"] or "", check.get("state") or "", ""]
    return [check["name"] or "", check.get("status") or "", check.get("conclusion") or ""]


def current_state(repository, number):
    owner, repo = repository.split("/")
    pr = gh_json(
        "pr", "view", str(number), "--repo", repository,
        "--json", "headRefOid,statusCheckRollup,reviews,comments",
    )
    try:
        return {
            "head": pr["headRefOid"],
            "checks": sorted(check_status(check) for check in pr["statusCheckRollup"] or []),
            "threads": review_threads(owner, repo, number),
            "reviews": len(pr["reviews"] or []),
            "comments": len(pr["comments"] or []),
        }
    except (KeyError, TypeError) as exc:
        raise PollError("gh の応答に状態の比較に必要な項目がありません") from exc


def read_state(path):
    try:
        with path.open(encoding="utf-8") as stream:
            state = json.load(stream)
    except FileNotFoundError:
        return None
    if not isinstance(state, dict):
        raise ValueError("状態ファイルが JSON オブジェクトではありません")
    return state


def save_state(path, state):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, delete=False,
    )
    temporary_path = Path(temporary.name)
    try:
        with temporary:
            json.dump(state, temporary)
            temporary.write("\n")
        temporary_path.replace(path)
    finally:
        temporary_path.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--pr", required=True, type=int)
    parser.add_argument("--state", required=True)
    parser.add_argument("--interval", type=float, default=60)
    parser.add_argument("--max-failures", type=int, default=3)
    args = parser.parse_args()
    repo_parts = args.repo.split("/")
    if len(repo_parts) != 2 or not all(repo_parts):
        parser.error("--repo は owner/name 形式で指定してください")
    if args.pr < 1 or args.max_failures < 1:
        parser.error("--pr と --max-failures には正の整数を指定してください")
    if not math.isfinite(args.interval) or args.interval < 0:
        parser.error("--interval には有限の非負数を指定してください")

    path = Path(args.state)
    failures = 0
    while True:
        try:
            state = current_state(args.repo, args.pr)
        except PollError as exc:
            failures += 1
            if failures >= args.max_failures:
                print(f"error: {exc}")
                return 1
        else:
            failures = 0
            try:
                previous = read_state(path)
                if previous is None:
                    save_state(path, state)
                    state_path = args.state.replace("\r", "\\r").replace("\n", "\\n")
                    print(f"initial: {state_path}")
                    return 0
                changes = [field for field in state if previous.get(field) != state[field]]
                if changes:
                    save_state(path, state)
                    print(f"changed: {','.join(changes)}")
                    return 0
            except OSError as exc:
                print(f"error: 状態ファイルを読み書きできません ({exc.strerror})")
                return 1
            except ValueError:
                print("error: 状態ファイルを JSON オブジェクトとして読めません")
                return 1
        time.sleep(args.interval)


if __name__ == "__main__":
    raise SystemExit(main())
